# Скопируйте в .env и подставьте значения из проекта Supabase:
# Project Settings → API. Оба значения предназначены для браузера, секрета в них нет:
# доступ к данным ограничивают политики RLS, а не тайна ключа.
#
# Пока файла .env нет, приложение работает на демо-данных в localStorage.

VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=

# Дальше — настоящие секреты, и нужны они только чтобы залить схему командой
# db:apply. Приложению они не нужны: в браузер Vite отдаёт лишь VITE_-переменные.
# Хватит любой одной строки, см. «Как залить схему» в README.

# Account → Access Tokens. Работает по HTTPS, то есть из любой сети.
SUPABASE_ACCESS_TOKEN=

# Кнопка Connect сверху, вкладка Session pooler. Требует доступа к порту 5432.
SUPABASE_DB_URL=
